# ============ LLM（OpenAI 兼容接口）============
# 留空则进入 mock 模式，项目仍可运行（不编造答案，仅返回知识库摘要）
OPENAI_API_KEY=sk-xxx
# OpenAI / DeepSeek / DashScope / 智谱 等兼容地址
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 单次 LLM 请求超时（秒）：第三方中转较慢时可调大；想更快回退到「知识库原文整理」可调小
LLM_TIMEOUT=60
# LLM 失败重试次数（0 表示不重试，直接走兜底回答）
LLM_MAX_RETRIES=2
# 采样温度
LLM_TEMPERATURE=0.3

# ============ Embedding ============
# 三种模式，按优先级从上到下：
#   1) 配了 EMBEDDING_API_KEY → 云端 Embedding 接口（推荐低配机器 / 无 GPU）
#   2) EMBEDDING_ALLOW_DOWNLOAD=false → 内置哈希向量器（无需 torch，但无语义能力）
#   3) 默认 → 本地 sentence-transformers 模型（bge-m3，约 2.3GB，需 ≥8GB 内存）
EMBEDDING_MODEL=BAAI/bge-m3
# 本地已下载模型时可指向本地目录，避免联网下载
EMBEDDING_MODEL_PATH=
# 是否允许加载 sentence-transformers 模型（需 torch）。
# 若环境里 torch 不可用（例如受限沙箱、缺少 VC 运行库），设为 false 可强制使用内置轻量向量器。
EMBEDDING_ALLOW_DOWNLOAD=true
# 内置轻量向量器的维度（仅在降级时生效）
EMBEDDING_DIM=384
# HuggingFace 离线模式：auto（默认，本地已有完整缓存就切离线）/ true / false
# 为什么需要它：huggingface_hub 加载模型时会对每个文件发一次联网 HEAD 检查，
# 当 huggingface.co 不可达时每次要重试 5 次，会让启动卡住数分钟。
HF_HUB_OFFLINE=auto
# 国内网络建议配置镜像站（首次下载模型时用）
# HF_ENDPOINT=https://hf-mirror.com

# ---- 云端 Embedding（可选，OpenAI 兼容接口）----
# 填了 EMBEDDING_API_KEY 就会优先走云端，不再加载本地模型：
# 内存占用可忽略，语义检索质量优于内置哈希向量器，适合 2 核 2G 等低配机器。
# 可选模型（阿里云百炼，OpenAI 兼容）：qwen3.7-text-embedding（默认 1024 维）、
#   qwen3.7-text-embedding-flash、text-embedding-v4、text-embedding-v3
# 也可填任意 OpenAI 兼容的 embedding 服务（OpenAI text-embedding-3-small 等）。
# EMBEDDING_API_KEY=
# 注意：一定要带 /compatible-mode/v1 后缀，否则路径不对（百炼业务空间专属域名同理）
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_MODEL=text-embedding-v4
# 单次请求最多传几条文本（text-embedding-v3/v4 上限为 10）
# EMBEDDING_API_BATCH=10
# 0 表示用模型默认维度；指定后必须与建库时一致
# EMBEDDING_API_DIM=
# EMBEDDING_API_TIMEOUT=60

# ============ 向量库 ============
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION=robot_customer_service
# 向量库后端：auto（默认，自动探测 chromadb 是否可用）/ chroma（强制）/ local（内置 NumPy 向量库）
# 提示：已确定不用 chromadb 时建议显式设 local，可省掉启动时一次子进程探测。
VECTOR_BACKEND=auto

# ============ 数据 ============
DATA_RAW_DIR=./data/raw
SQLITE_URL=sqlite:///./robot_cs.db

# ============ 工具类 Key（可选，未配置走 mock）============
WEATHER_API_KEY=
DEFAULT_CITY=杭州

# ============ 可选：重排模型（预留）============
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============================================================
# 场景组合参考（把下面几行取消注释即可）
# ============================================================
#
# ---- 场景 A：低配机器（2 核 2G / 无 GPU / 小带宽）推荐组合 ----
# 不加载本地 bge-m3（2.3GB 权重，加载后进程内存超 3GB，会被 OOM Killer 杀掉）。
# 首选云端 Embedding：内存占用可忽略，语义检索质量反而更好。
# EMBEDDING_ALLOW_DOWNLOAD=false
# VECTOR_BACKEND=local
# RERANK_ENABLED=false
# HF_HUB_OFFLINE=true
# EMBEDDING_API_KEY=sk-你的百炼Key
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_MODEL=qwen3.7-text-embedding-flash
#
# ---- 场景 B：低配机器且完全离线（无外网 / 不想调云端）----
# 只能用内置哈希向量器：零依赖、建库约 12 秒，但没有语义能力，
# 「这个月怎么保养」这类语义型提问会漏召回（关键词型提问尚可）。
# EMBEDDING_ALLOW_DOWNLOAD=false
# EMBEDDING_DIM=384
# VECTOR_BACKEND=local
# HF_HUB_OFFLINE=true
#
# ---- 场景 C：正常机器（≥8GB 内存，想要最好效果）----
# 默认配置即可（本地 bge-m3 + Chroma，1024 维）。
# 首次建库会下载约 2.3GB 模型，国内网络建议同时配 HF_ENDPOINT=https://hf-mirror.com

