# ---- Python 虚拟环境与缓存 ----
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/backend/**/build/
/build/
/dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- 环境变量 / 密钥 ----
.env
.env.local
.env.*.local

# ---- 向量库 / 数据库 ----
# 注意两点：
#   1) 必须加前导 /，否则会误伤 backend/app/vectorstore/、backend/app/models/ 等源码包目录；
#   2) gitignore 不支持行尾注释，注释必须单独成行。
/vectorstore/
# 多套向量库目录（正常路径 / 降级路径对照，见 eval/README.md）
/vectorstore_*/
*.db
*.sqlite
*.sqlite3
*.db-journal

# ---- 日志 ----
*.log
logs/

# ---- 构建 / 测试产物 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---- 模型缓存（如果下载到项目内）----
# 同样必须根锚定，否则会忽略 backend/app/models/ 源码包
/models/
/.cache/
/huggingface/

# ---- 临时目录（部分沙箱环境需要把 TMP 指到项目内）----
.tmp/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini